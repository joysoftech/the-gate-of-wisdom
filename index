      pollCounts: { A: 0, B: 0, C: 0 }
    };

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function getCurrentSet() {
      return CASE_SETS[state.selectedSetKey];
    }

    function getCurrentCase() {
      return getCurrentSet().cases[state.caseIndex];
    }

    function getActiveRulingC(caseData) {
      if (state.heard && state.searched) return caseData.rulings.C_BOTH;
      if (state.heard) return caseData.rulings.C_HEAR;
      if (state.searched) return caseData.rulings.C_SEARCH;
      return null;
    }

    function getRulingObject(caseData, key) {
      if (key === 'A') return caseData.rulings.A;
      if (key === 'B') return caseData.rulings.B;
      if (key === 'C') return getActiveRulingC(caseData);
      return null;
    }

