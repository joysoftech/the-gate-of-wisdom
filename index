    // ACTIONS & GAME FLOW
    // =========================================================================
    function toggleProjectorScale() {
      state.projectorLarge = !state.projectorLarge;
      const container = document.getElementById('appContainer');
      const label = document.getElementById('projectorLabel');
      if (state.projectorLarge) {
        container.classList.remove('max-w-2xl');
        container.classList.add('max-w-3xl', 'text-lg');
        label.textContent = 'Classroom View: Large';
      } else {
        container.classList.remove('max-w-3xl', 'text-lg');
        container.classList.add('max-w-2xl');
        label.textContent = 'Classroom View: Standard';
      }
    }

    function selectCaseSet(key) {
      state.selectedSetKey = key;
      render();
    }

    function togglePollMode() {
      state.classroomPollMode = !state.classroomPollMode;
      render();
    }

    function adjustPoll(option, delta) {
      state.pollCounts[option] = Math.max(0, state.pollCounts[option] + delta);
      render();
    }

    function startSession() {
      state.screen = 'game';
      state.caseIndex = 0;
      state.wisdomPoints = 20;
      state.heard = false;
      state.searched = false;
      state.selectedRulingKey = null;
      state.rulingConfirmed = false;
      state.precedents = [];
      state.history = [];
      state.scores = { justice: 0, mercy: 0, community: 0 };
      state.pollCounts = { A: 0, B: 0, C: 0 };
      document.getElementById('headerHomeBtn').classList.remove('hidden');
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function restartSession() {
      startSession();
    }

    function returnToTitle() {
      state.screen = 'title';
      document.getElementById('headerHomeBtn').classList.add('hidden');
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function triggerHear() {
      const c = getCurrentCase();
      if (state.heard || state.rulingConfirmed || state.wisdomPoints < c.hearCost) return;
      state.wisdomPoints -= c.hearCost;
      state.heard = true;
      // If C was selected, keep C selected as it upgrades
      render();
    }

    function triggerSearch() {
      const c = getCurrentCase();
      if (state.searched || state.rulingConfirmed || state.wisdomPoints < c.searchCost) return;
      state.wisdomPoints -= c.searchCost;
      state.searched = true;
      render();
    }

    function selectRuling(key) {
      if (state.rulingConfirmed) return;
      const c = getCurrentCase();
      if (key === 'C' && !getActiveRulingC(c)) return;
      state.selectedRulingKey = state.selectedRulingKey === key ? null : key;
      render();
    }

    function confirmRuling() {
      if (!state.selectedRulingKey || state.rulingConfirmed) return;
      const c = getCurrentCase();
      const chosen = getRulingObject(c, state.selectedRulingKey);
      if (!chosen) return;

      state.rulingConfirmed = true;
      state.scores.justice += chosen.scores.justice;
      state.scores.mercy += chosen.scores.mercy;
      state.scores.community += chosen.scores.community;

      const labelCode =
        state.selectedRulingKey === 'C'
          ? state.heard && state.searched
            ? 'C★'
            : 'C'
          : state.selectedRulingKey;

      state.precedents.push({
        caseNum: state.caseIndex + 1,
        title: c.title,
        text: chosen.precedent,
        code: labelCode
      });

      state.history.push({
        caseNum: state.caseIndex + 1,
        caseTitle: c.title,
        scripture: c.scripture,
        rulingKey: labelCode,
        rulingTitle: chosen.title,
        precedent: chosen.precedent,
        heard: state.heard,
        searched: state.searched
      });

      render();
    }

    function cancelRuling() {
      state.selectedRulingKey = null;
      render();
    }

    function nextCase() {
      const totalCases = getCurrentSet().cases.length;
      if (state.caseIndex + 1 < totalCases) {
        state.caseIndex += 1;
        state.heard = false;
        state.searched = false;
        state.selectedRulingKey = null;
        state.rulingConfirmed = false;
        state.pollCounts = { A: 0, B: 0, C: 0 };
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        state.screen = 'summary';
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function togglePrecedentRoll() {
      state.precedentRollOpen = !state.precedentRollOpen;
      render();
    }

