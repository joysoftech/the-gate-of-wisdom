                    </div>
                    <div class="font-mono font-bold text-xs sm:text-sm tracking-wider uppercase ${
                      state.searched ? 'text-emerald-400' : 'text-[#f3efe6]'
                    }">
                      ${state.searched ? '✓ SEARCHED' : `SEARCH (${c.searchCost}T)`}
                    </div>
                  </button>
                  ${
                    state.heard && !state.searched && canAffordSearch
                      ? `<p class="mt-1.5 text-[11px] italic text-[#9b9181] leading-snug">+5T to combine facts &amp; scripture (upgrades Ruling C)</p>`
                      : ''
                  }
                </div>
              </div>

              <!-- REVEALED CLUE CARDS -->
              ${
                state.heard
                  ? `
                <div class="rounded-xl border border-[#2d281f] border-l-4 border-l-amber-500 bg-[#17140f] p-4 space-y-1.5 animate-reveal">
                  <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-amber-400">
                    HEARD — HIDDEN FACT
                  </div>
                  <p class="text-sm sm:text-base text-[#f0eae0] leading-relaxed">
                    ${c.hiddenFact}
                  </p>
                </div>
              `
                  : ''
              }

              ${
                state.searched
                  ? `
                <div class="rounded-xl border border-[#22332a] border-l-4 border-l-emerald-400 bg-[#121915] p-4 space-y-1.5 animate-reveal">
                  <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-emerald-400">
                    SEARCHED — SCRIPTURAL &amp; ETHICAL PRECEDENT
                  </div>
                  <p class="text-sm sm:text-base text-[#f0eae0] leading-relaxed">
                    ${c.scripturalPrecedent}
                  </p>
                </div>
              `
                  : ''
              }
            </section>

            <!-- OPTIONAL CLASSROOM POLL BAR -->
            ${
              state.classroomPollMode
                ? `
              <section class="rounded-xl border border-[#26221a] bg-[#13110d] px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                <div class="text-[11px] font-mono uppercase tracking-wider text-[#978d7d]">
                  Classroom Straw Poll:
                </div>
                <div class="flex items-center gap-2">
                  ${['A', 'B', 'C']
                    .map((opt) => {
                      const disabledC = opt === 'C' && !rulingC;
                      return `
                        <div class="flex items-center gap-1 bg-[#191611] border border-[#2c271e] rounded-lg px-2 py-1 ${
                          disabledC ? 'opacity-40' : ''
                        }">
                          <span class="font-mono text-xs font-bold text-amber-400">${opt}:</span>
                          <span class="font-mono text-xs text-[#f3efe6] min-w-[1.25rem] text-center">${state.pollCounts[opt]}</span>
                          <button onclick="adjustPoll('${opt}', 1)" ${disabledC ? 'disabled' : ''}
                            class="w-5 h-5 rounded bg-[#252119] hover:bg-amber-500/20 text-xs font-bold text-[#d4cbbd] flex items-center justify-center">+</button>
                          <button onclick="adjustPoll('${opt}', -1)" ${disabledC ? 'disabled' : ''}
                            class="w-5 h-5 rounded bg-[#252119] hover:bg-rose-500/20 text-xs font-bold text-[#9c9281] flex items-center justify-center">−</button>
                        </div>
                      `;
                    })
                    .join('')}
                </div>
              </section>
            `
                : ''
            }

            <!-- RULINGS SECTION -->
            <section class="space-y-3">
              <div class="text-[11px] font-mono uppercase tracking-widest-plus text-[#8d8373]">
                RULE — SET A PRECEDENT
              </div>

              ${['A', 'B'].map((key) => renderRulingCard(key, c.rulings[key], false)).join('')}

              ${
                rulingC
                  ? renderRulingCard('C', rulingC, bothIntegrated)
                  : `
                <div class="rounded-xl border border-[#232019] bg-[#13110d] p-4 flex items-center gap-3.5 text-[#7a7163]">
                  <svg class="w-4 h-4 text-amber-500/60 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  <p class="text-xs sm:text-sm leading-relaxed">
                    <span class="font-mono uppercase tracking-wider text-[#8e8474]">UNEXAMINED RULING</span> — Spend 5T on HEAR or SEARCH to uncover hidden facts or theological precedent.
                  </p>
                </div>
              `
              }
            </section>
          `
          }
        </div>
      `;
    }

    function renderRulingCard(key, rulingObj, isIntegrated) {
      const isSelected = state.selectedRulingKey === key;
      return `
        <div onclick="selectRuling('${key}')"
          class="rounded-2xl p-5 cursor-pointer transition-all ${
            isSelected ? 'ruling-selected' : 'card-surface-interactive'
          }">
          <div class="space-y-3">
            <!-- Letter Badge -->
            <div class="w-7 h-7 rounded-md border border-[#363026] bg-[#1f1c16] flex items-center justify-center font-mono font-bold text-xs text-[#f3efe6]">
              ${key}
            </div>

            <div class="space-y-1.5">
              <h3 class="text-base sm:text-lg font-bold text-[#f7f3eb] leading-snug">
                ${rulingObj.title}
              </h3>
              <p class="text-xs sm:text-sm text-[#cfc6b6] leading-relaxed">
                ${rulingObj.desc}
              </p>
            </div>

            <p class="text-xs sm:text-sm italic text-amber-400/95">
              Precedent: “${rulingObj.precedent}”
            </p>

            ${
              isIntegrated
                ? `
              <div class="pt-0.5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md border border-emerald-500/45 bg-emerald-500/10 font-mono text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                  <span>✓ FACTS + SCRIPTURE INTEGRATED</span>
                </span>
              </div>
            `
                : ''
            }

            ${
              isSelected
                ? `
              <div class="pt-3 mt-3 border-t border-dashed border-[#383126] space-y-3 animate-reveal" onclick="event.stopPropagation()">
                <div class="text-sm font-bold text-[#f5f0e6]">Confirm this ruling?</div>
                <div class="flex flex-col gap-2">
                  <button onclick="confirmRuling()"
                    class="w-full py-3.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-obsidian font-mono font-extrabold text-xs sm:text-sm uppercase tracking-widest-plus transition shadow-md shadow-amber-500/20">
                    CONFIRM
                  </button>
                  <button onclick="cancelRuling()"
                    class="w-full py-3 px-4 rounded-xl border border-[#2f2a20] bg-[#14120e] hover:bg-[#1c1914] text-[#9b9180] hover:text-[#f3efe6] font-mono text-xs uppercase tracking-widest-plus transition">
                    CANCEL
                  </button>
                </div>
              </div>
            `
                : ''
            }
          </div>
        </div>
      `;
    }

    function renderGateReaction(c) {
      const chosen = getRulingObject(c, state.selectedRulingKey);
      const isFinalCase = state.caseIndex + 1 >= getCurrentSet().cases.length;

      return `
        <section class="card-surface rounded-2xl p-5 sm:p-6 space-y-5 animate-reveal">
          <div class="space-y-3">
            <div class="font-mono text-xs font-bold uppercase tracking-widest-plus text-amber-400">
              THE GATE REACTS
            </div>

            <p class="text-sm sm:text-base text-[#f2ece1] leading-relaxed">
              ${chosen.reaction}
            </p>

            <p class="text-xs sm:text-sm italic text-amber-400/95">
              Precedent inscribed: “${chosen.precedent}”
            </p>
          </div>

          <button onclick="nextCase()"
            class="w-full py-4 px-5 rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-[0.99] text-obsidian font-mono font-extrabold text-sm uppercase tracking-widest-plus transition flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20">
            <span>${isFinalCase ? 'CONCLUDE SESSION & UNLOCK VIRTUES' : 'NEXT CASE'}</span>
            <span>→</span>
          </button>
        </section>
      `;
    }

    function determineEthicistProfile() {
      const { justice, mercy, community } = state.scores;
      const total = justice + mercy + community;
      const integratedCount = state.history.filter((h) => h.heard && h.searched).length;

      if (integratedCount >= 2 && total >= 24) {
        return {
          archetype: 'Prophetic Synthesizer at the Gate',
          description:
            'You united empirical discernment (HEAR) with deep scriptural-philosophical hermeneutics (SEARCH), refusing false binaries between justice and mercy.'
        };
      }
      if (justice >= mercy && justice >= community) {
        return {
          archetype: 'Covenantal Jurist of Righteous Order',
          description:
            'Your rulings prioritized impartial accountability, structural integrity, and fidelity to moral law even under social pressure.'
        };
      }
      if (mercy > justice && mercy >= community) {
        return {
          archetype: 'Shepherd of Redemptive Compassion',
          description:
            'You consistently shielded the vulnerable from rigid legalism, insisting that statutes exist to serve human dignity and life.'
        };
      }
      return {
        archetype: 'Architect of Civic Shalom & Ubuntu',
        description:
          'Your jurisprudence focused on repairing social trust, preventing factional fracture, and sustaining harmony across the whole community.'
      };
    }

    function renderSummaryScreen() {
      const profile = determineEthicistProfile();
      const set = getCurrentSet();

      const normalizePct = (val) => Math.max(12, Math.min(100, Math.round(((val + 6) / 18) * 100)));

      return `
        <div class="space-y-6 animate-reveal">
          <!-- Unlocked Virtues Header -->
          <div class="card-surface rounded-2xl p-6 sm:p-7 space-y-5 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/[0.06] via-transparent to-amber-500/[0.06] pointer-events-none"></div>
            <div class="relative space-y-4">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-mono text-[11px] font-bold uppercase tracking-widest">
                <span>✓ SESSION COMPLETE • VIRTUES UNLOCKED</span>
              </div>

              <div>
                <div class="text-xs font-mono uppercase tracking-widest text-[#9c9281]">Jurisprudential Profile</div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-[#f7f3eb] mt-1">${profile.archetype}</h2>
                <p class="text-sm sm:text-base text-[#cfc6b6] mt-2 leading-relaxed">${profile.description}</p>
              </div>

              <!-- Three Unlocked Pillar Meters -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                ${[
                  { label: 'JUSTICE', val: state.scores.justice, color: 'bg-amber-400', text: 'text-amber-400' },
                  { label: 'MERCY', val: state.scores.mercy, color: 'bg-emerald-400', text: 'text-emerald-400' },
                  { label: 'COMMUNITY', val: state.scores.community, color: 'bg-sky-400', text: 'text-sky-400' }
                ]
                  .map(
                    (p) => `
                  <div class="rounded-xl border border-[#2b261e] bg-[#110f0c] p-3.5 space-y-2">
                    <div class="flex items-center justify-between font-mono text-xs">
                      <span class="font-bold tracking-widest text-[#e6dfd3]">${p.label}</span>
                      <span class="font-extrabold ${p.text}">${p.val >= 0 ? '+' + p.val : p.val}</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-[#211e18] overflow-hidden">
                      <div class="h-full ${p.color} rounded-full" style="width: ${normalizePct(p.val)}%"></div>
                    </div>
                  </div>
                `
                  )
                  .join('')}
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-[#26221a] text-xs font-mono text-[#9c9281]">
                <span>WISDOM REMAINING: <strong class="text-amber-400">${state.wisdomPoints}T</strong> / 20T</span>
                <span>MODULE: <strong class="text-[#e6dfd3]">${set.title}</strong></span>
              </div>
            </div>
          </div>

          <!-- Complete Inscribed Precedent Roll for Classroom Debrief -->
          <div class="card-surface rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="font-mono text-xs font-bold uppercase tracking-widest-plus text-amber-400">
                INSCRIBED CLASSROOM PRECEDENT ROLL
              </h3>
              <span class="text-[11px] font-mono text-[#8b8171]">For Seminar Debrief</span>
            </div>

            <div class="space-y-3">
              ${state.history
                .map(
                  (item) => `
                <div class="rounded-xl border border-[#29241c] bg-[#12100c] p-4 space-y-2">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="font-mono text-xs font-bold text-amber-400">
                      CASE ${item.caseNum} • RULING ${item.rulingKey}
                    </span>
                    <div class="flex items-center gap-1.5 text-[10px] font-mono">
                      ${
                        item.heard
                          ? '<span class="px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30">HEARD</span>'
                          : ''
                      }
                      ${
                        item.searched
                          ? '<span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">SEARCHED</span>'
                          : ''
                      }
                    </div>
                  </div>
                  <div class="font-bold text-sm sm:text-base text-[#f4efe6]">${item.caseTitle}</div>
                  <div class="text-xs text-[#a59b8a]">Decision: ${item.rulingTitle}</div>
                  <div class="text-xs sm:text-sm italic text-amber-300/95 pt-1 border-t border-[#221e17]">
                    P${item.caseNum}: “${item.precedent}”
                  </div>
                </div>
              `
                )
                .join('')}
            </div>
          </div>

          <!-- Classroom Discussion Prompts for Rev. Anand S. Deshbhratar -->
          <div class="card-surface rounded-2xl p-5 sm:p-6 space-y-3">
            <div class="font-mono text-xs font-bold uppercase tracking-widest-plus text-emerald-400">
              FACULTY SEMINAR DEBRIEF QUESTIONS
            </div>
            <ul class="space-y-2 text-xs sm:text-sm text-[#d4cbbd] list-disc pl-5 leading-relaxed">
              <li>Where did limited Wisdom Points (20T) force our class to rely on unexamined assumptions?</li>
              <li>How did uncovering hidden human facts (HEAR) alter our reading of the authoritative texts (SEARCH)?</li>
              <li>Do our three inscribed precedents form a coherent moral philosophy, or do they stand in creative tension?</li>
            </ul>
          </div>

          <!-- Action Buttons -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button onclick="restartSession()"
              class="py-3.5 px-5 rounded-xl bg-amber-500 hover:bg-amber-400 text-obsidian font-mono font-extrabold text-xs sm:text-sm uppercase tracking-widest-plus transition">
              REPLAY THIS MODULE
            </button>
            <button onclick="returnToTitle()"
              class="py-3.5 px-5 rounded-xl border border-[#2f2a20] bg-[#161410] hover:border-amber-500/40 text-[#f3efe6] font-mono font-bold text-xs sm:text-sm uppercase tracking-widest-plus transition">
              SWITCH CASE MODULE
            </button>
          </div>
        </div>
      `;
    }

    function render() {
      const app = document.getElementById('appContainer');
      if (state.screen === 'title') {
        app.innerHTML = renderTitleScreen();
      } else if (state.screen === 'game') {
        app.innerHTML = renderGameScreen();
      } else if (state.screen === 'summary') {
        app.innerHTML = renderSummaryScreen();
      }
    }

    window.onload = function () {
      render();
    };
  </script>
</body>
</html>
